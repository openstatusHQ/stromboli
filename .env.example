# Required: encrypts connector credentials at rest. Generate with: openssl rand -base64 32
STROMBOLI_SECRET_KEY=
# Required to expose the instance: clients send "Authorization: Bearer <token>".
# Generate with: openssl rand -hex 32
STROMBOLI_API_TOKEN=
# Optional: separate token for /webhooks/* (defaults to STROMBOLI_API_TOKEN).
# Pass it as ?token=..., an Authorization: Bearer header, or X-Webhook-Secret.
STROMBOLI_WEBHOOK_TOKEN=

# Required for investigations (briefs work without it): models are "provider:model".
# Providers: anthropic, openai, google, openrouter, deepseek, ollama, or any OpenAI-compatible
# API via STROMBOLI_PROVIDER_<NAME>_BASE_URL / _API_KEY.
# Vercel AI Gateway (one key, every model): ids like "openai/gpt-5" go through it, as in the AI SDK.
# AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1
# STROMBOLI_MODEL=anthropic:claude-opus-5-5
# STROMBOLI_EFFORT=high
# Per task: triage runs until the mitigation is published, investigate finds the root cause.
# STROMBOLI_TRIAGE_MODEL=anthropic:claude-haiku-5-5
# STROMBOLI_TRIAGE_EFFORT=low
# STROMBOLI_INVESTIGATE_MODEL=openai:gpt-5
# STROMBOLI_INVESTIGATE_EFFORT=high
# STROMBOLI_MAX_TOOL_CALLS=30
# STROMBOLI_INVESTIGATION_TIMEOUT=8m
# STROMBOLI_DEDUPE_WINDOW=30m

# Optional: let investigations propose Fly machine actions (restart, clone, cordon...)
# that run only after a human approves them with `stromboli actions approve`.
# STROMBOLI_ACTIONS_ENABLED=false
# STROMBOLI_ACTION_TTL=30m

# Optional: check Fly machine metrics (memory, CPU, disk, volumes) on a schedule
# and investigate when one crosses its threshold.
# STROMBOLI_HEALTHCHECK_INTERVAL=1h

# Optional: serve stromboli's MCP tools at /mcp for Claude Code, Cursor... (needs STROMBOLI_API_TOKEN).
# STROMBOLI_MCP_TOKEN, when set, is the only token /mcp accepts and reaches only the MCP tools.
# STROMBOLI_MCP_ENABLED=false
# STROMBOLI_MCP_TOKEN=

# Optional: post reports to Slack. Create the app from deploy/slack/manifest.json (README → Slack),
# invite the bot to the channel, then paste its Bot User OAuth Token (xoxb-...).
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
# Optional: Apply/Reject buttons on proposed actions (needs STROMBOLI_ACTIONS_ENABLED=true).
# Set the app's Interactivity Request URL to https://<stromboli>/slack/interactions.
# SLACK_SIGNING_SECRET=
# Slack user IDs allowed to click; empty = anyone in the channel.
# SLACK_APPROVERS=

# docker compose only: the image tag (pin a release, e.g. 0.1.0), the host port and the
# Postgres password (URL-safe, e.g. openssl rand -hex 16; set it before the first start:
# Postgres only applies it when the volume is created).
# STROMBOLI_VERSION=latest
# STROMBOLI_PORT=8080
# POSTGRES_PASSWORD=stromboli
