# Required: encrypts connector credentials at rest. Generate with: openssl rand -base64 32
OPENSRE_SECRET_KEY=
# Required to expose the instance: clients send "Authorization: Bearer <token>".
OPENSRE_API_TOKEN=
# Optional: separate token for /webhooks/* (defaults to OPENSRE_API_TOKEN).
# Pass it as ?token=..., an Authorization: Bearer header, or X-Webhook-Secret.
OPENSRE_WEBHOOK_TOKEN=

# Required for investigations (briefs work without it): models are "provider:model".
# Providers: anthropic, openai, google, openrouter, deepseek, ollama, or any OpenAI-compatible
# API via OPENSRE_PROVIDER_<NAME>_BASE_URL / _API_KEY.
# Vercel AI Gateway (one key, every model): ids like "openai/gpt-5" go through it, as in the AI SDK.
# AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OPENSRE_MODEL=anthropic:claude-opus-5-5
# OPENSRE_EFFORT=high
# Per task: triage runs until the mitigation is published, investigate finds the root cause.
# OPENSRE_TRIAGE_MODEL=anthropic:claude-haiku-5-5
# OPENSRE_TRIAGE_EFFORT=low
# OPENSRE_INVESTIGATE_MODEL=openai:gpt-5
# OPENSRE_INVESTIGATE_EFFORT=high
# OPENSRE_MAX_TOOL_CALLS=30
# OPENSRE_INVESTIGATION_TIMEOUT=8m
# OPENSRE_DEDUPE_WINDOW=30m

# Optional: let investigations propose Fly machine actions (restart, clone, cordon...)
# that run only after a human approves them with `opensre actions approve`.
# OPENSRE_ACTIONS_ENABLED=false
# OPENSRE_ACTION_TTL=30m

# Optional: check Fly machine metrics (memory, CPU, disk, volumes) on a schedule
# and investigate when one crosses its threshold.
# OPENSRE_HEALTHCHECK_INTERVAL=1h

# Optional: post reports to Slack (bot scopes: chat:write).
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
# Optional: Apply/Reject buttons on proposed actions (needs OPENSRE_ACTIONS_ENABLED=true).
# Set the app's Interactivity Request URL to https://<opensre>/slack/interactions.
# SLACK_SIGNING_SECRET=
# Slack user IDs allowed to click; empty = anyone in the channel.
# SLACK_APPROVERS=
