{
  "display_information": {
    "name": "opensre",
    "description": "AI SRE agent: posts the mitigation and root cause of your alerts.",
    "background_color": "#1f2937"
  },
  "features": {
    "bot_user": {
      "display_name": "opensre",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": ["chat:write"]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://opensre.example.com/slack/interactions"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
