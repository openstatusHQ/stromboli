---
import { Code } from "astro:components";
import Base from "../layouts/Base.astro";
import CopyCommand from "../components/CopyCommand.astro";
import volcano from "../components/volcano.txt?raw";
import { SECTIONS } from "../lib/docs";

const features = [
  {
    title: "Mitigation first",
    body: "It proposes a concrete fix (rollback, restart, scale up…) within a few tool calls, before it digs for the root cause.",
  },
  {
    title: "Then the root cause",
    body: "It tests hypotheses against your logs, metrics and deploys, and writes a structured report.",
  },
  {
    title: "Read-only by default",
    body: "It suggests and never acts on its own. The one opt-in exception: Fly.io machine actions a named human approves.",
  },
  {
    title: "Any LLM",
    body: "Claude by default; OpenAI, Gemini, DeepSeek, Ollama, OpenRouter or Vercel AI Gateway work too.",
  },
  {
    title: "No data ingestion",
    body: "Logs and metrics are queried on demand where they already live. Only the evidence each investigation used is stored.",
  },
  {
    title: "Yours to host",
    body: "One Go binary and a Postgres database. Docker Compose, Railway or Fly.io in one command. MIT licensed.",
  },
];

const steps = [
  ["alert", "Alertmanager, Grafana, openstatus or any webhook fires."],
  ["brief", "It gathers logs, metrics, deploys and the service catalog. No LLM yet."],
  ["mitigate", "It posts how to stop the bleeding to Slack, fast."],
  ["investigate", "It tests hypotheses and posts the root cause in the thread."],
];

const quickstart = `cp .env.example .env   # STROMBOLI_SECRET_KEY, STROMBOLI_API_TOKEN, ANTHROPIC_API_KEY...
docker compose up -d   # stromboli + Postgres on http://localhost:8080

stromboli connector add loki loki url=http://loki:3100
stromboli catalog discover loki
stromboli investigate api --description "5xx on /v1/monitors"`;

const connectors = ["Loki", "Axiom", "CloudWatch", "Google Cloud", "Prometheus", "Fly.io", "GitHub", "Vercel", "Slack", "MCP"];
---

<Base title="stromboli · open-source AI SRE agent">
  <main class="container">
    <section class="hero">
      <pre class="volcano" aria-hidden="true">{volcano}</pre>
      <h1>An open-source AI SRE agent <br class="wide" />you host yourself.</h1>
      <p class="lede muted">
        When an alert fires, stromboli gathers the context, tells you how to stop the bleeding, then finds the root
        cause, and posts all of it to Slack.
      </p>
      <div class="actions">
        <a class="btn primary" href="/docs/tutorials/01-first-investigation/">Get started →</a>
        <a class="btn" href="/docs/">Read the docs</a>
        <a class="btn" href="https://github.com/openstatushq/stromboli">GitHub ↗</a>
      </div>
      <CopyCommand command="brew install openstatushq/stromboli/stromboli" />
    </section>

    <section>
      <h2 class="label">// what it does</h2>
      <div class="cells features">
        {
          features.map((f, i) => (
            <div class="feature">
              <span class="muted num">{String(i + 1).padStart(2, "0")}</span>
              <h3>{f.title}</h3>
              <p class="muted">{f.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section>
      <h2 class="label">// how an investigation works</h2>
      <ol class="cells steps">
        {
          steps.map(([name, body]) => (
            <li>
              <code>{name}</code>
              <p class="muted">{body}</p>
            </li>
          ))
        }
      </ol>
      <p class="muted small">
        More in <a href="/docs/explanation/investigation-lifecycle/">the life of an investigation</a>.
      </p>
    </section>

    <section>
      <h2 class="label">// quickstart</h2>
      <div class="code">
        <Code code={quickstart} lang="sh" themes={{ light: "github-light", dark: "github-dark" }} defaultColor={false} />
      </div>
      <div class="cells connectors">
        {connectors.map((c) => <span>{c}</span>)}
      </div>
    </section>

    <section>
      <h2 class="label">// documentation</h2>
      <div class="cells sections">
        {
          SECTIONS.map((s) => (
            <a href={`/docs/${s.id}/`}>
              <strong>{s.label} →</strong>
              <span class="muted">{s.blurb}</span>
            </a>
          ))
        }
      </div>
    </section>
  </main>
</Base>

<style>
  section {
    margin-top: 4rem;
  }
  .hero {
    margin-top: 3rem;
  }
  .volcano {
    margin: 0 0 2rem;
    font-family: var(--font-mono);
    /* 70 columns, scaled down to fit narrow screens */
    font-size: min(12px, calc((100vw - 32px) / 43));
    line-height: 1.25;
    color: var(--muted-foreground);
    overflow: hidden;
  }
  h1 {
    font-size: clamp(1.5rem, 4.5vw, 2.4rem);
    line-height: 1.2;
    letter-spacing: -0.03em;
    margin: 0 0 1rem;
  }
  .wide {
    display: none;
  }
  @media (min-width: 640px) {
    .wide {
      display: inline;
    }
  }
  .lede {
    max-width: 42rem;
    margin: 0 0 1.75rem;
    font-size: 15px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .btn {
    display: inline-block;
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--border);
    text-decoration: none;
  }
  .btn:hover {
    background: var(--muted);
  }
  .btn.primary {
    background: var(--foreground);
    color: var(--background);
    border-color: var(--foreground);
  }
  .btn.primary:hover {
    opacity: 0.85;
  }
  .label {
    font-size: 13px;
    font-weight: 400;
    color: var(--muted-foreground);
    margin: 0 0 0.75rem;
  }
  .features {
    grid-template-columns: minmax(0, 1fr);
  }
  .feature {
    padding: 1rem;
  }
  .feature h3 {
    font-size: 14px;
    margin: 0.25rem 0;
  }
  .feature p {
    margin: 0;
    font-size: 13px;
  }
  .num {
    font-size: 12px;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    grid-template-columns: minmax(0, 1fr);
  }
  .steps li {
    padding: 1rem;
  }
  .steps code {
    font-family: var(--font-mono);
    font-weight: 700;
  }
  .steps li::before {
    content: "→ ";
    color: var(--lava);
  }
  .steps p {
    margin: 0.25rem 0 0;
    font-size: 13px;
  }
  .small {
    font-size: 13px;
  }
  .small a {
    color: var(--link);
  }
  .code :global(pre) {
    margin: 0;
    padding: 1rem;
    border: 1px solid var(--border);
    border-bottom: 0;
    background: var(--muted) !important;
    font-size: 13px;
    line-height: 1.6;
    overflow-x: auto;
  }
  .connectors {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    font-size: 13px;
  }
  .connectors span {
    padding: 0.4rem 0.75rem;
    color: var(--muted-foreground);
  }
  .sections {
    grid-template-columns: minmax(0, 1fr);
  }
  .sections a {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem;
    text-decoration: none;
    font-size: 13px;
  }
  .sections a:hover {
    background: var(--muted);
  }
  @media (min-width: 640px) {
    .features,
    .sections {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .connectors {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
  @media (min-width: 900px) {
    .features {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .sections {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
</style>
